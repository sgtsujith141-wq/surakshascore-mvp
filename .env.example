# Supabase project credentials — REQUIRED.
#
# Copy this file to `.env` and fill in the values from your own Supabase
# project (Project Settings -> API). Never commit the filled-in `.env`.
#
# Without these the app renders a "Configuration Required" screen instead of
# the dashboard: sign-in and all persistence go through Supabase.
#
# Apply `supabase/migration/20260813122249_create_digital_security_schema.sql`
# to the project to create the expected tables.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
